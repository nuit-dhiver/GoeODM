---
import Base from '@/layouts/Base.astro';
import GalleryCard from '@/components/GalleryCard.astro';
import Slideshow from '@/components/Slideshow.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import StatsSection from '@/components/StatsSection.astro';
import { useTranslations, getGalleryPath, type Lang } from '@/i18n/ui';
import { getAssetUrl } from '@/utils/assets';
import { getCollection } from 'astro:content';

const lang: Lang = 'de';
const t = useTranslations(lang);

const slideshowImages = [
  { src: getAssetUrl('/images/slideshow/placeholder-1.jpg'), alt: 'Denkmal' },
  { src: getAssetUrl('/images/slideshow/placeholder-2.jpg'), alt: 'Skulptur' },
  { src: getAssetUrl('/images/slideshow/placeholder-3.jpg'), alt: 'Brunnen' },
];

const allGalleries = await getCollection('galleries');

const galleryCards = [
  {
    id: 'fountains' as const,
    title: allGalleries.find(g => g.id === 'fountains') ? t('gallery.fountains.title') : t('nav.fountains'),
    description: allGalleries.find(g => g.id === 'fountains') ? t('gallery.fountains.description') : '',
    href: getGalleryPath(lang, 'fountains'),
    icon: 'fountain' as const,
    accentColor: 'blue' as const,
  },
  {
    id: 'monuments' as const,
    title: allGalleries.find(g => g.id === 'monuments') ? t('gallery.monuments.title') : t('nav.monuments'),
    description: allGalleries.find(g => g.id === 'monuments') ? t('gallery.monuments.description') : '',
    href: getGalleryPath(lang, 'monuments'),
    icon: 'monument' as const,
    accentColor: 'red' as const,
  },
  {
    id: 'artworks' as const,
    title: allGalleries.find(g => g.id === 'artworks') ? t('gallery.artworks.title') : t('nav.artworks'),
    description: allGalleries.find(g => g.id === 'artworks') ? t('gallery.artworks.description') : '',
    href: getGalleryPath(lang, 'artworks'),
    icon: 'artwork' as const,
    accentColor: 'gold' as const,
  },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Open Museum',
  url: 'https://openmuseum.io',
  description: t('home.tagline'),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Göttingen',
    addressRegion: 'Niedersachsen',
    addressCountry: 'DE',
  },
  sameAs: [
    'https://github.com/nuit-dhiver/Open-Museum',
    'https://sketchfab.com/alex-emami/collections/gottingen-open-digital-museum-c959f7b2b98e4b1d8619248bb8c831fd',
  ],
};
---

<Base title={t('home.title')} description={t('home.tagline')}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <section class="bg-black text-white py-20 sm:py-32 border-b-brutal border-brand-gold">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-heading text-5xl sm:text-7xl font-bold uppercase tracking-wider mb-6">
        <span class="text-brand-gold">Open Museum</span>
      </h1>
      <p class="text-lg sm:text-xl text-white/70 max-w-2xl mx-auto leading-relaxed">
        {t('home.tagline')}
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-off-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {galleryCards.map((gallery) => (
          <GalleryCard gallery={gallery} />
        ))}
      </div>
    </div>
  </section>

  <!-- <section class="py-16 sm:py-24 bg-white border-y-3 border-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold uppercase tracking-wider mb-8 text-center">
        {t('home.slideshow.title')}
      </h2>
      <Slideshow images={slideshowImages} />
    </div>
  </section> -->

  <StatsSection lang={lang} />

  <FeaturedWork lang={lang} />
</Base>
