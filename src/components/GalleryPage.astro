---
import Base from '@/layouts/Base.astro';
import WorkCard from '@/components/WorkCard.astro';
import { useTranslations, type Lang, getGalleryPath } from '@/i18n/ui';
import { getCollection } from 'astro:content';
import { getAssetUrl } from '@/utils/assets';
import { hasLocale, localized } from '@/utils/locales';

interface Props {
  lang: Lang;
  galleryId: 'fountains' | 'monuments' | 'artworks';
}

const { lang, galleryId } = Astro.props;
const t = useTranslations(lang);

const allWorks = await getCollection('works');
const allGalleries = await getCollection('galleries');

const gallery = allGalleries.find((g) => g.id === galleryId);

const works = allWorks.filter(
  (w) => w.data.gallery === galleryId && hasLocale(w.data, lang),
);

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: gallery ? localized(gallery.data.title, lang, galleryId) : galleryId,
  numberOfItems: works.length,
  itemListElement: works.map((work, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}${getGalleryPath(lang, galleryId)}${work.id}/`,
    name: localized(work.data.title, lang, 'title'),
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: `${siteUrl}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: gallery ? localized(gallery.data.title, lang, galleryId) : galleryId },
  ],
};

const galleryTitle = gallery ? localized(gallery.data.title, lang, galleryId) : galleryId;
const galleryDescription = gallery ? localized(gallery.data.description, lang, galleryId) : '';
const galleryDescKey = `gallery.${galleryId}.description`;
---

<Base title={`${galleryTitle} — Open Museum`} description={galleryDescription}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Page header -->
  <section class="bg-black text-white py-12 sm:py-16 border-b-brutal border-brand-gold">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-heading text-4xl sm:text-5xl font-bold uppercase tracking-wider mb-3">
        {galleryTitle}
      </h1>
      <p class="text-white/70 text-lg">
        {galleryDescription || t(galleryDescKey)}
      </p>
    </div>
  </section>

  <!-- Works grid -->
  <section class="py-12 sm:py-16 bg-off-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {works.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {works.map((work) => (
            <WorkCard
              slug={work.id}
              title={localized(work.data.title, lang, 'title')}
              poster={work.data.poster ? getAssetUrl(work.data.poster) : undefined}
              gallery={work.data.gallery}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-lg text-black/50 font-heading uppercase tracking-wider">
            {t('noworks')}
          </p>
        </div>
      )}
    </div>
  </section>
</Base>