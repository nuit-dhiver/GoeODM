---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getLangFromUrl, useTranslations, getAlternateLanguagePath, languages } from '@/i18n/ui';
import '@/styles/global.css';
import { getAssetUrl } from '@/utils/assets';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /**
   * Locales this particular page exists in. Work pages pass the locales the
   * work is published in, so hreflang never points at a page that was not
   * generated. Everything else exists in every locale.
   */
  availableLocales?: string[];
}

const { title, description = '', ogImage, availableLocales } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const alternatePath = getAlternateLanguagePath(Astro.url.pathname, lang);
const alternateURL = new URL(alternatePath, Astro.site);
const isRootPath = Astro.url.pathname === import.meta.env.BASE_URL;

// Advertise a translation only when it was actually built. A work published in
// one language has no counterpart to point at, and claiming otherwise sends
// crawlers to a 404.
const localesToAdvertise = (availableLocales ?? Object.keys(languages)).filter((code) =>
  Object.hasOwn(languages, code),
);

// NOTE: getAlternateLanguagePath swaps between exactly two locales. Adding a
// third means generalizing it to take a target locale; this loop is ready for
// that, the helper is not.
const alternateLinks = localesToAdvertise.map((code) => ({
  code,
  href: isRootPath
    ? new URL(`${import.meta.env.BASE_URL}${code}/`, Astro.site)
    : code === lang
      ? canonicalURL
      : alternateURL,
}));

// x-default is the fallback for languages that match none of the above, so it
// should always exist. When a page has only one locale, that page is the
// fallback; otherwise the site root, which language-routes the visitor.
const xDefaultURL =
  alternateLinks.length > 1 ? new URL(import.meta.env.BASE_URL, Astro.site) : canonicalURL;

// Strip markdown syntax and truncate for social meta descriptions
const plainDescription = description
  .replace(/!\[.*?\]\(.*?\)/g, '')   // images
  .replace(/\[([^\]]+)\]\(.*?\)/g, '$1') // links
  .replace(/[*_`#>~\-]+/g, '')       // formatting chars
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 200);

// Resolve OG image to absolute URL for social media crawlers.
// Fall back to the default site OG image when no specific image is available.
const DEFAULT_OG_IMAGE = new URL('/images/og-default.png', Astro.site).href;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href)
  : DEFAULT_OG_IMAGE;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {plainDescription && <meta name="description" content={plainDescription} />}
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang -->
    {alternateLinks.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Open Museum" />
    <meta property="og:title" content={title} />
    {plainDescription && <meta property="og:description" content={plainDescription} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@openmuseumio" />
    <meta name="twitter:title" content={title} />
    {plainDescription && <meta name="twitter:description" content={plainDescription} />}
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- model-viewer -->
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>

    <!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1HHZM5WNDH"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-1HHZM5WNDH');
</script>

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} availableLocales={availableLocales} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
